__pycache__/
*.pyc
*.py[cod]

# 训练产物（可由 pipeline 重新生成）
# 散落在根目录的日志不进仓库
*.log

# 但归档在 logs/ 下的训练、数据生成、评估报告是有价值的记录，保留
!logs/train/*.log
!logs/selfplay/*.log
!logs/eval/*.log

# 后端服务的运行时日志不保留
logs/service/

data/*.npz
data/*.jsonl
models/*.pt
# models/v2/ 等子目录里的权重同样忽略（单个最大 10 MB）
models/**/*.pt

# 网页权重是需要随页面一起使用的产物，不忽略
!web/models/weights.json

.DS_Store
.idea/
.vscode/
